%%BeginDocument: semantics.eps
%!PS-Adobe-2.0 EPSF-2.0
%%Title: semantics.eps
%%Creator: fig2dev Version 3.2 Patchlevel 3d
%%CreationDate: Thu Apr 24 15:47:05 2003
